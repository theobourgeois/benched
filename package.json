{
  "name": "benched",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run lint && tsc -b && tsc --noEmit -p tsconfig.worker.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "node scripts/check-imports.mjs",
    "test": "npm run lint && vitest run",
    "test:e2e": "playwright test",
    "data:nhl": "node scripts/fetch-nhl.ts",
    "format": "prettier --write src tests *.ts *.json index.html README.md",
    "format:check": "prettier --check src tests *.ts *.json index.html README.md",
    "rooms": "wrangler dev --port 8787 --local",
    "rooms:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@react-three/fiber": "^9.4.0",
    "lucide-react": "^0.577.0",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.1.4",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.132.0"
  }
}
